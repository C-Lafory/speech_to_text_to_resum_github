# # STAGE 1: BUILD
# FROM golang:1.23-alpine AS builder
# WORKDIR /build
# COPY go.mod go.sum ./
# RUN go mod download
# COPY . .
# RUN CGO_ENABLED=0 GOOS=linux go build -o main ./cmd/main.go

# # STAGE 2: RUNTIME
# FROM alpine:3.19
# RUN apk add --no-cache ca-certificates tzdata
# WORKDIR /app
# COPY --from=builder /build/main /app/main
# RUN chmod +x /app/main
# CMD ["/app/main"]

FROM golang:1.23-alpine AS builder

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN echo "==> Starting go build..." \
 && CGO_ENABLED=0 GOOS=linux go build -v -o main ./cmd/main.go \
 && echo "==> Build completed!" \
 && ls -la /build/main \
 && file /build/main

 # STAGE 2: RUNTIME
FROM alpine:3.19
# RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY --from=builder /build/main /app/main
RUN chmod +x /app/main
CMD ["/app/main"]